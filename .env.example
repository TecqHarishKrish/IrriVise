# IrriVise local configuration. Every variable is optional; defaults are safe for a single-user laptop.
# Nothing here is secret — IrriVise needs no API keys, accounts or paid services.

# Where data/, artifacts/ and the SQLite database live (default: repository root)
# IRRIVISE_DATA_ROOT=/path/to/irrivise-data
# Override the database file (default: $IRRIVISE_DATA_ROOT/data/irrivise.sqlite3)
# IRRIVISE_DATABASE=/path/to/irrivise.sqlite3
# Allowed browser origins for the API (comma-separated)
# IRRIVISE_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Worker concurrency and safety limits
# IRRIVISE_MAX_PARALLEL_TRAINING=1
# IRRIVISE_MAX_PARALLEL_JOBS=2
# IRRIVISE_MAX_QUEUED_JOBS=25
# IRRIVISE_HEARTBEAT_TIMEOUT_S=60
# IRRIVISE_CANCEL_GRACE_S=30
# IRRIVISE_MAX_UPLOAD_BYTES=5000000
# Frontend dev proxy target (used by apps/web/vite.config.ts)
# IRRIVISE_API_URL=http://127.0.0.1:8000
